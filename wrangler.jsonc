{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rihla",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
     "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rihla-explorer-activity",
      "database_id": "e76da8ed-55ba-43c9-8d15-da8aa388f91b",
      "migrations_dir": "migrations"
    }
  ]
}
